# Which data provider the app uses. Defaults to `mock` when unset, so a fresh
# clone and every CI run work with no network. `espn` arrives in M2.
VITE_DATA_PROVIDER=mock

# Simulated-game clock controls. Both are optional; the URL params `?simOffset=`
# and `?simTime=` override them per-request.
#
# VITE_SIM_OFFSET  milliseconds added to the real clock
# VITE_SIM_TIME    absolute epoch milliseconds, pinning the clock outright

# Postgres connection string for the M6 write-through cache, read server-side
# only — never exposed to the browser, hence no VITE_ prefix. `POSTGRES_URL` is
# accepted as an alias, which is the name Vercel's Neon integration sets.
#
# Optional by design: with this unset the proxy serves scores exactly as it did
# before M6 and simply skips the cache write, so a fresh clone and CI need no
# database. `npm run db:migrate` applies db/migrations/ to whatever it points at.
#
# DATABASE_URL=postgres://user:password@host/db?sslmode=require
